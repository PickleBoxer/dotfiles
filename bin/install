#!/bin/bash
#
# Install dotfiles

set -e  # Exit on error (but we use || true for optional steps)

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }

echo ""
step "Install Dotfiles"
echo ""
warn "This will install/update your terminal setup"
echo ""
read -p "Continue? (y/n) " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo ""
    step "Cancelled"
    echo ""
    exit 0
fi

echo ""
sudo -v

# Start
touch ~/.hushlogin

# Create dev directory
mkdir -p ~/dev/code

# Check if Xcode Command Line Tools are installed
if ! xcode-select -p &>/dev/null; then
  echo "Xcode Command Line Tools not found. Installing..."
  xcode-select --install
else
  echo "Xcode Command Line Tools already installed."
fi

step "Installing Oh My Zsh"
if [ ! -d ~/.oh-my-zsh ]; then
    rm -rf ~/.oh-my-zsh
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | sh -s -- --unattended || warn "Oh My Zsh installation failed"
fi
success "Oh My Zsh installed"

# Git configuration
step "Configuring Git"
ln -sf ~/.dotfiles/home/.gitconfig ~/.gitconfig
ln -sf ~/.dotfiles/home/.global-gitignore ~/.global-gitignore
success "Git configured"

# Symlinks
step "Creating symlinks"
rm -f ~/.zshrc ~/.mackup.cfg
ln -sf ~/.dotfiles/home/.zshrc ~/.zshrc
ln -sf ~/.dotfiles/macos/.mackup.cfg ~/.mackup.cfg
mkdir -p ~/bin
ln -sf ~/.dotfiles/bin/php-format ~/bin/php-format
mkdir -p ~/.config/ghostty
ln -sf ~/.dotfiles/config/ghostty/config ~/.config/ghostty/config
ln -sf ~/.dotfiles/config/ghostty/themes ~/.config/ghostty/themes
success "Symlinks created"

# NPM setup
step "Configuring npm"
mkdir -p ~/.npm-packages
npm config set prefix ~/.npm-packages || warn "npm config failed"
success "npm configured"

# Homebrew
step "Installing Homebrew"
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
success "Homebrew installed"

# Trust third-party taps used by the Brewfile (must happen before `brew bundle`:
# Homebrew's tap-trust security gate blocks loading formulae/casks from untrusted
# taps entirely, e.g. shivammathur/php's php/php@8.4 or nicoverbruggen/cask's phpmon)
step "Trusting Homebrew taps"
brew tap shivammathur/php
brew tap shivammathur/extensions
brew tap nicoverbruggen/cask
brew tap ddev/ddev
brew tap oven-sh/bun
brew trust --tap shivammathur/php shivammathur/extensions nicoverbruggen/cask ddev/ddev oven-sh/bun || warn "Trusting taps failed"
success "Taps trusted"

# Install all packages from Brewfile
step "Installing packages from Brewfile"
brew bundle --file=~/.dotfiles/config/Brewfile || warn "Some packages failed (likely already installed)"
success "Brewfile processed"

# fnm - Node.js version manager
step "Setting up fnm"
eval "$(fnm env --use-on-cd)" || warn "fnm activation failed"
fnm install --lts || warn "fnm install failed"
fnm use lts-latest || warn "fnm use failed"
success "fnm configured"

# Global npm packages
step "Installing global npm packages"
npm install -g intelephense || warn "intelephense already installed or failed"
success "npm packages processed"

# PHP development extras (extensions + global Composer packages)
echo ""
read -p "Install PHP extensions and global Composer packages? (y/n) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    step "Installing PHP extensions"
    # Installed from shivammathur/extensions (same tap and mechanism PHP Monitor's own
    # extension manager uses) instead of pecl: precompiled, version-pinned, and avoids
    # duplicate `extension=` entries in php.ini if PHP Monitor later manages the same one.
    PHP_VERSION=$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')
    brew install "shivammathur/extensions/imagick@${PHP_VERSION}" || warn "imagick already installed or failed"
    brew install "shivammathur/extensions/memcached@${PHP_VERSION}" || warn "memcached already installed or failed"
    brew install "shivammathur/extensions/xdebug@${PHP_VERSION}" || warn "xdebug already installed or failed"
    brew install "shivammathur/extensions/phpredis@${PHP_VERSION}" || warn "phpredis already installed or failed"
    success "PHP extensions processed"

    step "Installing global Composer packages"
    composer global require laravel/pint || warn "pint already installed or failed"
    composer global require laravel/envoy || warn "envoy already installed or failed"
    composer global require laravel/installer || warn "installer already installed or failed"
    composer global require spatie/phpunit-watcher || warn "phpunit-watcher already installed or failed"
    composer global require laravel/lsp || warn "laravel/lsp already installed or failed"
    success "Composer packages processed"
else
    warn "Skipping PHP extensions and Composer packages"
fi

# Optional: Laravel Valet for local development (alternative or alongside ddev)
echo ""
read -p "Install Laravel Valet? (y/n) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    step "Installing Laravel Valet"
    composer global require laravel/valet || warn "valet already installed or failed"
    valet install || warn "valet install failed"
    success "Laravel Valet installed"
else
    warn "Skipping Laravel Valet"
fi

# Spotlight exclusions
bash ~/.dotfiles/bin/exclude-from-spotlight || warn "Spotlight exclusions had issues"

# DDEV SSH commit signing
step "Configuring DDEV SSH commit signing"
mkdir -p "$HOME/.ddev/homeadditions/.ssh/config.d"
[ -L "$HOME/.ddev/homeadditions/.gitconfig" ] || ln -s "$HOME/.gitconfig" "$HOME/.ddev/homeadditions/.gitconfig"
[ -L "$HOME/.ddev/homeadditions/.ssh/id_ed25519.pub" ] || ln -s "$HOME/.ssh/id_ed25519.pub" "$HOME/.ddev/homeadditions/.ssh/id_ed25519.pub"
ssh-add ~/.ssh/id_ed25519 2>/dev/null || warn "Could not add SSH key to agent (key may not exist yet)"
mkcert -install || warn "mkcert -install failed"
success "DDEV SSH commit signing configured"

# Claude Code setup
echo ""
read -p "Install Claude Code? (y/n) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    bash ~/.dotfiles/bin/install-claude-code || warn "Claude Code setup had issues"
else
    warn "Skipping Claude Code installation"
fi

# Done
echo ""
success "Installation complete!"
echo ""
step "Next steps:"
echo "  • Restore settings: mackup restore (if you have backups)"
echo "  • Customize aliases: ~/.dotfiles-custom/shell/.aliases"
echo "  • Set font in Terminal.app to JetBrainsMono Nerd Font for best experience"
echo ""
echo "Optional:"
echo "  • Discover more agent skills: https://skills.sh"
echo ""
